# PostgreSQL connection string (Neon). Use the DIRECT connection (host without
# "-pooler") wherever migrations run: through the pooler, Prisma's migration lock
# can be left stuck on an idle connection and later migrations fail with P1002.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Port the API listens on (Render sets this automatically)
PORT=3000

# Secret for POST/PUT/DELETE via the x-api-key header. Leave unset to disable writes.
ADMIN_API_KEY=

# Comma-separated origins allowed to call the API, e.g. https://your-app.vercel.app
# Leave unset to allow any origin (fine for local development).
CORS_ORIGIN=
