// Database schema for the bestiary. Change it with a migration
// (npx prisma migrate dev --name <change>), never by editing the database directly.
// Run migrations over Neon's DIRECT connection, not the "-pooler" one.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Era {
  YEARS_OF_THE_TREES
  FIRST_AGE
  SECOND_AGE
  THIRD_AGE
}

// Chapters of the codex, in reading order (Postgres sorts enums by declaration)
enum Category {
  MAIAR
  ORCS
  TROLLS
  BEASTS
  DRAGONS
  ENTS
  BIRDS
}

// A bestiary entry. Its page number in the book is not stored: it is the
// creature's position in codex order (category, then name). Likewise the danger
// label ("Extreme") is derived from dangerRating on the frontend.
model Creature {
  id                 Int               @id @default(autoincrement())
  name               String            @unique
  category           Category
  originEra          Era               @default(THIRD_AGE)
  master             String?
  description        String            @db.Text
  createdAt          DateTime          @default(now())

  // Codex / Manuscript Additions
  taxonomy           String?
  behavior           String?           @db.Text
  dangerRating       Int?              @default(1)
  imageUrl           String?
  figureCaption      String?
  anatomicalSketches Json?             @default("[]")

  notables           NotableBeast[]
  habitats           CreatureHabitat[]

  @@map("creatures")
}

// A famous individual of a kind (e.g. Smaug for the Fire-drake), shown under
// "Notable Specimens". Deleted along with its creature.
model NotableBeast {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  title       String?
  status      String
  creatureId  Int
  creature    Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@map("notable_beasts")
}

model Habitat {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String?           @db.Text
  creatures   CreatureHabitat[]

  @@map("habitats")
}

// Join table: a creature can live in many habitats, and a habitat can hold
// many creatures (e.g. Mordor has Orcs, Olog-hai and Great Spiders).
model CreatureHabitat {
  creatureId Int
  habitatId  Int
  creature   Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  habitat    Habitat  @relation(fields: [habitatId], references: [id], onDelete: Cascade)

  @@id([creatureId, habitatId])
  @@map("creature_habitats")
}
